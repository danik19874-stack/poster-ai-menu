SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
POSTER_APPLICATION_ID=
POSTER_APPLICATION_SECRET=
POSTER_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/callback
ADMIN_PASSWORD=
# 32 random bytes, base64-encoded — e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
# Encrypts poster_token / gemini api_key at rest. Losing this key makes existing encrypted
# secrets in the database permanently undecryptable — back it up somewhere safe.
SECRETS_ENCRYPTION_KEY=
